{
  "name": "@uigrep/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "zip": "wxt zip && wxt zip -b firefox"
  },
  "dependencies": {
    "@uigrep/schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wxt": "^0.20.7"
  }
}
