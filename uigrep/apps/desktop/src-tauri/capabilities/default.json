{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pill-capability",
  "description": "Minimal permissions for the uigrep status pill",
  "windows": ["pill"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "global-shortcut:allow-is-registered",
