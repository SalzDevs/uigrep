{
  "productName": "uigrep",
  "version": "0.1.0",
  "identifier": "dev.uigrep.app",
  "build": {
    "beforeDevCommand": "pnpm desktop:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm desktop:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "pill",
        "visible": false,
        "title": "uigrep",
        "width": 230,
        "height": 54,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true
      },
      {
        "label": "setup",
        "title": "Set up uigrep",
        "url": "index.html?view=setup",
        "width": 940,
        "height": 760,
        "minWidth": 600,
        "minHeight": 520,
        "visible": false,
        "center": true,
        "backgroundColor": "#0c111b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "resources": {
      "runtime/": "runtime/"
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
