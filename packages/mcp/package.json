{
  "name": "@uigrep/mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP stdio adapter for uigrep — retrieve UI capture context in coding agents",
  "license": "MIT",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "bin": {
    "uigrep-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@uigrep/bridge": "workspace:*",
    "@uigrep/schema": "workspace:*",
    "zod": "^4.1.5"
  }
}
