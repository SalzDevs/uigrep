{
  "name": "@uigrep/schema",
  "version": "0.1.0",
  "type": "module",
  "description": "Canonical capture contracts and budgets for uigrep",
  "license": "MIT",
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.5"
  }
}
