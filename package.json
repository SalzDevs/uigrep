{
  "name": "uigrep",
  "version": "0.1.0",
  "private": true,
  "description": "Point at UI changes and send precise, local context to coding agents.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @uigrep/desktop --filter @uigrep/extension dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "test:runtime": "node scripts/smoke-mcp.mjs",
    "typecheck": "pnpm --filter @uigrep/schema build && pnpm --filter @uigrep/bridge build && pnpm -r typecheck",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.3.1",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tar": "^7.5.7",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4",
    "yauzl": "^3.2.0"
  }
}
