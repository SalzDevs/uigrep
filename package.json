{
  "name": "uigrep",
  "private": true,
  "version": "0.0.1",
  "description": "Grep your UI \u2014 point at what's wrong, an agent fixes it.",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "demo": "python3 -m http.server 5173 --directory demo",
    "agent": "pnpm --filter @uigrep/mcp-server start"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@12.3.4"
}